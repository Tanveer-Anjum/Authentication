<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beautiful Home Page</title>
    <!-- <link rel="stylesheet" href="../public/index.css" /> -->

    <style>
      /* new */
      /* General styles */
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        line-height: 1.6;
        background: wheat;
        color: #333;
      }

      /* Header styles */
      header {
        text-align: center;
        padding: 1.5rem;
        background: linear-gradient(to right, #6a11cb, #2575fc);
        color: white;
      }

      header h1 {
        margin: 0;
        font-size: 1.5rem;
      }

      /* Slideshow styles */
      .slideshow-container {
        position: relative;
        max-width: 100%;
        margin: auto;
        overflow: hidden;
      }

      .slide {
        display: none;
      }

      .slide img {
        width: 100%;
        height: 600px;
      }

      .caption {
        text-align: center;
        position: absolute;
        bottom: 20px;
        width: 100%;
        color: white;
        background: rgba(0, 0, 0, 0.5);
        padding: 10px;
        font-size: 1.2rem;
      }

      /* Navigation buttons */
      .prev,
      .next {
        cursor: pointer;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: white;
        background: rgba(0, 0, 0, 0.5);
        padding: 10px;
        font-size: 2rem;
        border: none;
        border-radius: 50%;
      }

      .prev {
        left: 10px;
      }

      .next {
        right: 10px;
      }

      /* Footer styles */
      footer {
        background: #333;
        color: white;
        padding: 2rem 1rem;
      }

      .footer-container {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
      }

      .footer-column {
        flex: 1;
        margin: 0.5rem;
      }

      .footer-column h4 {
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        border-bottom: 2px solid #fff;
      }

      .footer-column ul {
        list-style: none;
        padding: 0;
      }

      .footer-column ul li a {
        color: white;
        text-decoration: none;
      }

      .footer-column ul li a:hover {
        text-decoration: underline;
      }

      .footer-bottom {
        text-align: center;
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Welcome to Our Website</h1>
    </header>

    <div class="slideshow-container">
      <div class="slide fade">
        <img src="/images/p1.jpg" alt="Slide 1" />
        <div class="caption">Slide 1 Caption</div>
      </div>
      <div class="slide fade">
        <img src="/images/p2.jpg" alt="Slide 2" />
        <div class="caption">Slide 2 Caption</div>
      </div>
      <div class="slide fade">
        <img src="/images/p3.jpg" alt="Slide 3" />
        <div class="caption">Slide 3 Caption</div>
      </div>
      <!-- Next and previous buttons -->
      <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
      <a class="next" onclick="plusSlides(1)">&#10095;</a>
    </div>

    <br />

    <footer>
      <div class="footer-container">
        <div class="footer-column">
          <h4>About Us</h4>
          <p>
            This is my final exam project we work hard day and night and this is
            our result. Thanks!
          </p>
        </div>
        <div class="footer-column">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Contact</a></li>
          </ul>
        </div>
        <div class="footer-column">
          <h4>Contact</h4>
          <p>Email: info@example.com</p>
          <p>Phone: +123 456 7890</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2025 Your Website. All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      let slideIndex = 0;
      showSlides();

      function showSlides() {
        let slides = document.querySelectorAll(".slide");
        slides.forEach((slide) => (slide.style.display = "none"));

        slideIndex++;
        if (slideIndex > slides.length) slideIndex = 1;

        slides[slideIndex - 1].style.display = "block";
        setTimeout(showSlides, 4000); // Change image every 3 seconds
      }

      function plusSlides(n) {
        let slides = document.querySelectorAll(".slide");
        slides.forEach((slide) => (slide.style.display = "none"));

        slideIndex += n;
        if (slideIndex > slides.length) slideIndex = 1;
        if (slideIndex < 1) slideIndex = slides.length;

        slides[slideIndex - 1].style.display = "block";
      }
    </script>
  </body>
</html>
